<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1e1e2e"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <!-- Judul Widget (Diperbesar) -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PYCLEAN AGENT"
        android:textColor="#89b4fa"
        android:textSize="18sp" 
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Tombol Sakti 1 -->
    <Button
        android:id="@+id/btn_clean"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#a6e3a1"
        android:textColor="#11111b"
        android:text="⚡ EXECUTE SORT"
        android:textStyle="bold"
        android:paddingTop="12dp"
        android:paddingBottom="12dp" />

    <!-- Jarak pemisah untuk fitur selanjutnya -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="12dp" />

    <!-- ============================================== -->
    <!-- SLOT UNTUK FITUR BARU NANTI (Contoh)           -->
    <!-- Tinggal uncomment kalau mau langsung dipakai   -->
    <!-- ============================================== -->
    
