<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1e1e2e"
    android:padding="12dp">

    <!-- Judul Widget -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:text="PYCLEAN AGENT"
        android:textColor="#89b4fa"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Tombol versi RemoteViews (Pake TextView biar gak kepotong) -->
    <TextView
        android:id="@+id/btn_clean"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_title"
        android:layout_marginTop="10dp"
        android:background="#a6e3a1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="EXECUTE SORT"
        android:textColor="#11111b"
        android:textSize="12sp"
        android:textStyle="bold" />

</RelativeLayout>